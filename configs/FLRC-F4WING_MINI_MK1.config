# Wingflight / STM32F405 (S405) 4.6.0-0.0.17 Aug 31 2026 / 12:02:50 (213cd51) MSP API: 22.2

board_name F4WING_MINI_MK1
board_design WGFL
manufacturer_id FLRC

# resources
resource BEEPER 1 B09
resource MOTOR 1 B06
resource SERVO 1 B15
resource SERVO 2 C08
resource SERVO 3 C09
resource SERVO 4 A08
resource SERVO 5 B01
resource PPM 1 A03
resource SERIAL_TX 5 C12
resource SERIAL_TX 6 C06
resource SERIAL_RX 1 A10
resource SERIAL_RX 2 A03
resource SERIAL_RX 3 C11
resource SERIAL_RX 5 D02
resource SERIAL_RX 6 C07
resource I2C_SCL 1 B08
resource I2C_SDA 1 B07
resource LED 1 A14
resource LED 2 A13
resource SPI_SCK 1 A05
resource SPI_SCK 2 B13
resource SPI_MISO 1 B04
resource SPI_MISO 2 C02
resource SPI_MOSI 1 A07
resource SPI_MOSI 2 C03
resource ADC_BATT 1 C04
resource ADC_CURR 1 C05
resource ADC_RSSI 1 B00
resource ADC_EXT 1 C00
resource SDCARD_CS 1 C01
resource PINIO 1 A04
resource PINIO 2 B05
resource FLASH_CS 1 C13
resource GYRO_EXTI 1 C15
resource GYRO_CS 1 C14
resource FREQ 1 B11

# timer
timer C09 AF2
# pin C09: TIM3 CH4 (AF2)
timer C08 AF2
# pin C08: TIM3 CH3 (AF2)
timer B15 AF1
# pin B15: TIM1 CH3N (AF1)
timer A08 AF1
# pin A08: TIM1 CH1 (AF1)
timer B11 AF1
# pin B11: TIM2 CH4 (AF1)
timer B06 AF2
# pin B06: TIM4 CH1 (AF2)
timer B01 AF3
# pin B01: TIM8 CH3N (AF3)
timer B09 AF3
# pin B09: TIM11 CH1 (AF3)
timer A03 AF3
# pin A03: TIM9 CH2 (AF3)

# dma
dma ADC 1 1
# ADC 1: DMA2 Stream 4 Channel 0
dma pin B06 0
# pin B06: DMA1 Stream 0 Channel 2

# feature
feature RX_SERIAL
feature TELEMETRY
feature FREQ_SENSOR
feature DYN_NOTCH
feature RPM_FILTER

# serial
serial 4 64 115200 57600 0 115200

# master
set mag_bustype = I2C
set mag_i2c_device = 1
set mag_hardware = NONE
set baro_bustype = I2C
set baro_i2c_device = 1
set baro_hardware = AUTO
set current_meter = ADC
set battery_meter = ADC
set vbat_scale = 210
set ibata_scale = 150
set beeper_inversion = ON
set beeper_od = OFF
set system_hse_mhz = 8
set pinio_config = 1,1,1,1
set pinio_box = 40,41,255,255
set flash_spi_bus = 2
set blackbox_device = SPIFLASH
set gyro_1_bustype = SPI
set gyro_1_spibus = 1
set gyro_1_sensor_align = CW270FLIP
set gyro_1_align_pitch = 1800
set gyro_1_align_yaw = 2700
set serialrx_provider = CRSF
set align_board_yaw = 270
set freq_input_pull = PULLUP
set freq_input_edge = FALLING
set freq_input_minhz = 25
