# Wingflight / STM32H730 (SH73)
# FrSky Aegis Lite (STM32H730, 32 MHz HSE, GD25Q128 OCTOSPI flash for the firmware)
# The firmware executes in place from the OCTOSPI flash, started by the Wingflight loader in the
# internal flash, which takes firmware updates over DFU. The STM32H730 hex holds both. The first
# flash goes through the ROM DFU (BOOT0): it writes the loader over FrSky's ArduPilot boot loader,
# then the Configurator writes the firmware through the loader.
# Ports S1-S8 are the stock firmware's PWM(1)-PWM(8): A03 A02 A01 A00 C08 C07 A10 A09
# (FrSky's config tool sets SERVOn_* for Sn), so SERVO n is Sn. S9 is UART7 TX (E08, SBUS out
# in the stock firmware), used here as TLM. UART4 (D01 TX, D00 RX) is the C1 port, UART10 the C2 port.
# The motors are on S7 and S8, which share TIM1 (a servo there would change the motor's time base).

board_name AEGISLITE
manufacturer_id FRSK

# resources
resource SERVO 1 A03
resource SERVO 2 A02
resource SERVO 3 A01
resource SERVO 4 A00
resource SERVO 5 C08
resource SERVO 6 C07
resource MOTOR 1 A10
resource MOTOR 2 A09
resource SERIAL_TX 3 D08
resource SERIAL_TX 4 D01
resource SERIAL_TX 7 E08
resource SERIAL_TX 10 E03
resource SERIAL_RX 3 D09
resource SERIAL_RX 4 D00
resource SERIAL_RX 7 E07
resource SERIAL_RX 10 E02
resource I2C_SCL 1 B08
resource I2C_SCL 3 A08
resource I2C_SDA 1 B09
resource I2C_SDA 3 C09
resource LED 1 E10
resource SPI_SCK 2 D03
resource SPI_SCK 6 C12
resource SPI_MISO 2 C02
resource SPI_MISO 6 B04
resource SPI_MOSI 2 C03
resource SPI_MOSI 6 A07
resource ADC_BATT 1 C04
resource ADC_EXT 1 C05
resource FLASH_CS 1 A04
resource GYRO_EXTI 1 D07
resource GYRO_CS 1 B12

# OCTOSPI1 flash holding the firmware, must stay untouched:
# D11 D12 B13 D13 (IO0-3), E11 (NCS), B02 (CLK)

# I2C1: internal (parameter EEPROM), I2C3: barometer SPL06 at 0x77 and external connector

# timer
timer A03 AF2
# pin A03: TIM5 CH4 (AF2)
timer A02 AF2
# pin A02: TIM5 CH3 (AF2)
timer A01 AF2
# pin A01: TIM5 CH2 (AF2)
timer A00 AF2
# pin A00: TIM5 CH1 (AF2)
timer C08 AF2
# pin C08: TIM3 CH3 (AF2)
timer C07 AF2
# pin C07: TIM3 CH2 (AF2)
timer A10 AF1
# pin A10: TIM1 CH3 (AF1)
timer A09 AF1
# pin A09: TIM1 CH2 (AF1)

# dma
dma ADC 1 8
# ADC 1: DMA2 Stream 0
dma ADC 3 9
# ADC 3: DMA2 Stream 1

# feature
feature RX_SERIAL

# serial
serial 2 64 115200 57600 0 115200

# master
set gyro_1_bustype = SPI
set gyro_1_spibus = 2
set gyro_1_sensor_align = CW270
set baro_hardware = DPS310
set baro_bustype = I2C
set baro_i2c_device = 3
set baro_i2c_address = 119
set mag_bustype = I2C
set mag_i2c_device = 3
set i2c1_pullup = ON
set i2c1_clockspeed_khz = 400
set i2c3_pullup = ON
set i2c3_clockspeed_khz = 400
set flash_spi_bus = 6
set blackbox_device = SPIFLASH
set battery_meter = ADC
set vbat_scale = 620
set vbat_divider = 100
set serialrx_provider = FBUS
set serialrx_inverted = ON
set serialrx_halfduplex = ON
